# Force LF line endings for scripts and source files, regardless of the
# committer's OS. CRLF line endings silently break shebang lines
# (e.g. `#!/bin/bash\r`) when a script is run on Linux/macOS.
* text=auto eol=lf

*.sh text eol=lf
*.rb text eol=lf
*.py text eol=lf
*.php text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.cs text eol=lf
*.swift text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.svg -text
